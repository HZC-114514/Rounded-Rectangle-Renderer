{"blockDat":{},"dynamicDat":{"dynamic_variables":[],"dynamic_myblocks":[]},"glsl":"#version 300 es\n\n//This is the default shader for the shader editor!\n//These functions are here and are written for the GLSL 3.0 specification.\n//You can revert it to GLSL 1.0 by removing the version number\n\nprecision highp float;\n// defualt precision for floats\n\n//our output for color\nout highp vec4 fragColor;\n//Base Variables\nattribute highp vec4 a_position;\nattribute highp vec4 a_color;\nattribute highp vec2 a_texCoord;\n\nvarying highp vec4 v_color;\nvarying highp vec2 v_texCoord;\n\nvarying highp float v_depth;\nuniform highp float u_timer;\nuniform highp mat4 u_transform;\n\n//Pen+ Textures\nuniform mediump vec2 u_res;\n\n//Base functions\n\n//Some missing math functions\nhighp float log10(highp float a) {\n  return log(a)/log(10.0);\n}\n\nhighp float eulernum(highp float a) {\n  return 2.718 * a;\n}\n\n//Psuedorandomness\nhighp vec4 pcg4d(highp vec4 v)\n{\n  v = v * 1664525.0 + 1013904223.0;\n  \n  v.x += v.y*v.w;\n  v.y += v.z*v.x;\n  v.z += v.x*v.y;\n  v.w += v.y*v.z;\n  \n  v.x += v.z*v.w;\n  v.y += v.y*v.x;\n  v.z += v.x*v.w;\n  v.w += v.y*v.x;\n  \n  return vec4(v);\n}\n\nhighp vec4 daveRandomRange(highp float lowR, highp float highR)\n{\n  lowp float r = (gl_FragCoord.x * 50.25313532) + (gl_FragCoord.y * 21.5453) + u_timer;\n  highp float randomizer = r*r/u_timer/5398932.234523;\n  return clamp(vec4(\n  fract(sin(mod(randomizer*(91.3458), 1440.0)) * 47453.5453),\n  fract(sin(mod(randomizer*(80.3458), 1440.0)) * 48456.5453),\n  fract(sin(mod(randomizer*(95.3458), 1440.0)) * 42457.5453),\n  fract(sin(mod(randomizer*(85.3458), 1440.0)) * 47553.5453)\n  ), lowR, highR);\n}\n\nhighp vec4 HSVToRGB(highp float hue, highp float saturation, highp float value, highp float a) {\n  highp float huePrime = mod(hue,360.0);\n  highp float c = (value/100.0) * (saturation/100.0);\n  highp float x = c * (1.0 - abs(mod(huePrime/60.0, 2.0) - 1.0));\n  highp float m = (value/100.0) - c;\n  highp float r = 0.0;\n  highp float g = 0.0;\n  highp float b = 0.0;\n  \n  if (huePrime >= 0.0 && huePrime < 60.0) {\n      r = c;\n      g = x;\n      b = 0.0;\n  } else if (huePrime >= 60.0 && huePrime < 120.0) {\n      r = x;\n      g = c;\n      b = 0.0;\n  } else if (huePrime >= 120.0 && huePrime < 180.0) {\n      r = 0.0;\n      g = c;\n      b = x;\n  } else if (huePrime >= 180.0 && huePrime < 240.0) {\n      r = 0.0;\n      g = x;\n      b = c;\n  } else if (huePrime >= 240.0 && huePrime < 300.0) {\n      r = x;\n      g = 0.0;\n      b = c;\n  } else if (huePrime >= 300.0 && huePrime < 360.0) {\n      r = c;\n      g = 0.0;\n      b = x;\n  }\n  r += m;\n  g += m;\n  b += m;\n  return vec4(r, g, b, a);\n}\n\nhighp vec4 HSVToRGB(highp vec4 colorInput) {\n  return HSVToRGB(colorInput.x, colorInput.y, colorInput.z, colorInput.w);\n}\n\nhighp vec4 RGBToHSV(highp float r, highp float g, highp float b, highp float a) {\n  //Get the brightest and darkest channels\n  highp float CMax = r;\n  if (g > CMax) { CMax = g; }\n  if (b > CMax) { CMax = b; }\n\n  highp float CMin = r;\n  if (g < CMin) { CMin = g; }\n  if (b < CMin) { CMin = b; }\n\n  highp float Delta = CMax - CMin;\n\n  highp float H = 0.0;\n\n  //Multiply and get the Hue\n  if (CMax == r) {\n      H = 60.0 * mod(((g - b) / Delta), 6.0);\n  }\n  if (CMax == g) {\n      H = 60.0 * ((b - r) / Delta + 2.0);\n  }\n  if (CMax == b) {\n      H = 60.0 * ((r - g) / Delta + 4.0);\n  }\n\n  //Set the saturation\n  highp float S = 0.0;\n  if (CMax != 0.0) {\n      S = Delta / CMax;\n  }\n    \n  return vec4(H, S * 100.0, CMax * 100.0, a);\n}\n\nhighp vec4 RGBToHSV(highp vec4 colorInput) {\n  return RGBToHSV(colorInput.x, colorInput.y, colorInput.z, colorInput.w);\n}\n\nhighp vec4 rotation(highp vec4 invec4) {\n  return vec4(\n    (invec4.y) * u_transform[1][0] + (invec4.x) * u_transform[1][1],\n    (invec4.y) * u_transform[1][1] - (invec4.x) * u_transform[1][0],\n    invec4.zw\n  );\n}\n\n//---------CheeseNeko---------//\n// At 2026/9/15\n// 1.8.5\n\n//优化代码结构\n//Border拥有独立Alpha\n\nuniform float Rounded;\nuniform vec2 Size;\nuniform vec4 Color;\nuniform vec2 Coor;\n\nuniform float Border;\nuniform vec4 BorderColor;\n\nuniform float Smooth;\nuniform float G2;\n\nuniform sampler2D Img;\nuniform float ImgRatio;\nuniform float ImgZoom;\nuniform vec2 ImgSize;\n\nuniform float ShadowMode;\nuniform float ShadowInsideRounded;\nuniform vec2 ShadowInsideSize;\nuniform vec2 ShadowOffset;\nuniform float ShadowSize;//Only Inside Mode\n\nfloat radius(in float angle, in float r){\n  float p = 7.;\n  return r/pow(pow(abs(cos(angle)), p) + pow(abs(sin(angle)), p) + 3. * pow(abs(cos(angle) * sin(angle)), p/2.), 1./p);\n}\n\nfloat RoundBox(in vec2 p, in vec2 a, in float r)\n{ \n  vec2 q = abs(p) - a + r;\n  return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r;\n}\n\nfloat G2RoundBox (in vec2 p, in vec2 s, in float r)//G2 RoundBox SDF  By CheeseNeko\n{\n  float pi = radians(180.0);\n  vec2 absp = abs(p.xy);\n  vec2 symbol = p.xy / absp.xy;\n  vec2 RoundedCenter = s.xy - r;\n  if (absp.x >= RoundedCenter.x && absp.y >= RoundedCenter.y && absp.x > 0. && absp.y > 0.){\n    vec2 p_RC = p - RoundedCenter * symbol;\n    float a = atan(p_RC.y / p_RC.x);\n    float d = radius(a, r);\n    return length(p_RC) - d;\n  } else if(absp.x < RoundedCenter.x && absp.y < RoundedCenter.y){\n    return RoundBox(p, s, 0.); //实际大小为圆角矩形大小，渲染范围为 s.xy - r\n  } else if(absp.x >= RoundedCenter.x && absp.x > 0.){\n    return absp.x - s.x;\n  } else {\n    return absp.y - s.y;\n  }\n}\n\nfloat RoundBoxSDF(in vec2 p, in vec2 a, in float r, in float G2) //圆角矩形SDF\n{ \n  float d;\n  if (G2 == 0.){\n    return RoundBox(p, a, r);\n  } else {\n    return G2RoundBox(p, a, r);\n  }\n}\n\n\n//Fragment Shader\nvoid fragment() { \n  gl_FragColor = v_color;\n  float Long = max(Size.x, Size.y);\n  vec2 size = Size / Long;\n  float border = Border / Long * (1. - abs(ShadowMode));\n  vec2 imgSize = ImgSize * ImgZoom;\n  vec2 uv = v_texCoord * 2. - 1.; //原点居中\n  float rounded = min(Rounded + G2 * 7.25, min(Size.x, Size.y) / 2.) * (1. + G2 * 0.315);\n  vec2 Offset = ShadowOffset / Long * 2.;\n  \n  vec3 c_border;\n  float d_border;\n  float a_border;\n\n  vec3 c_main;\n  float d_main;\n  float a_main;\n\n  float alpha;\n  vec3 color;\n\n  d_main = RoundBoxSDF(uv * size - Offset * float(ShadowMode == -1.), (size - 2. * border - ShadowSize * 2. / Long * float(ShadowMode == -1.)) * .999, ((rounded - (Border * float(ShadowMode == 0.)) - ShadowSize * float(ShadowMode == -1.)) * 2. / Long) * .975, G2);\n  if (ShadowMode == -1.){\n    d_main = smoothstep( 0. , Smooth / (Long / 2.), d_main);\n  } else {\n    d_main = smoothstep( - Smooth / (Long / 2.) , 0., d_main);\n  }\n\n  a_main = Color.a - d_main;\n\n  if (ShadowMode == 0.) {\n\n    if (border > 0. && ShadowMode == 0.) {\n      d_border = RoundBoxSDF(uv * size, size * .999, (rounded * 2. / Long) * .975, G2);\n      d_border = smoothstep( - Smooth / (Long / 2.) , 0., d_border);\n      a_border = (BorderColor.a - d_border) * d_main;\n      a_main = Color.a - d_border;\n    }\n\n    c_border = BorderColor.rgb / 255.;\n    c_main = Color.rgb / 255.;\n\n    if (ImgRatio > 0.) {\n      vec2 s = imgSize / Size;\n      c_main = texture(Img, (v_texCoord - (1. - s) / 2.) / s + Coor / imgSize).rgb * ImgRatio + c_main * (1. - ImgRatio);\n    }\n\n    alpha = 1. - (1. - a_border) * (1. - a_main);\n    color = (c_border * a_border + c_main * a_main * (1. - a_border))/alpha;\n\n  } else {\n\n    rounded = min(ShadowInsideRounded + G2 * 7.25, min(ShadowInsideSize.x, ShadowInsideSize.y) / 2.) * (1. + G2 * 0.35);\n\n    float d_inside = RoundBoxSDF(uv * size - Offset * float(ShadowMode == 1.), ShadowInsideSize / Long * 0.999, (rounded * 2. / Long) * .975, G2);\n    d_inside = smoothstep( - 1.5 / (Long / 2.) , 0., d_inside);\n    color = Color.rgb / 255.;\n\n    if (ShadowMode == 1.) {\n      alpha = (Color.a - d_main) * d_inside;\n    } else {\n      alpha = d_main * (1. - d_inside) * Color.a;\n    }\n    \n  }\n  fragColor = vec4(color * alpha, alpha);\n}\n\n//Vertex Shader\nvoid vertex() {\n  gl_Position = (rotation(a_position) + vec4(u_transform[0][2],u_transform[0][3],0,0)) * vec4(a_position.w * u_transform[0][0],a_position.w * -u_transform[0][1],1,1) - vec4(0,0,1,0);\n  v_color = a_color;\n  v_texCoord = a_texCoord;\n}","isText":true,"savedVarState":{"Smooth":"2","color":["0","175","200","1"],"Rounded":"100","Size":["400","300"],"g2":"1","img":"Pepper","Rimg":1,"coor":["0","0"],"G2":"1","Coor":["0","0"],"imgSize":["10","10"],"imgZoom":"1","Border":"10","BorderColor":["255","255","255","1"],"Color":["0","175","255","1"],"ImgRatio":"0.1","ImgZoom":"1","ImgSize":["21","21"],"ShadowIntensity":"40","ShadowSize":"50","RenderSize":["400","300"],"ShadowMode":"-1","ShadowInsideSize":["400","300"],"ShadowInsideRounded":"100","ShadowOffset":["0","0"]}}